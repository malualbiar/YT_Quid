# ─────────────────────────────────────────────────────────────
# Django Configuration
# ─────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-youtube-artist-analytics-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────
# Database (Render / Production)
# Set DATABASE_URL to use PostgreSQL. When unset, SQLite is used.
# Render sets this automatically when you attach a PostgreSQL database.
# Example: postgres://user:password@hostname:5432/dbname
# ─────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# YouTube Data API v3 Key
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ─────────────────────────────────────────────────────────────
# Google OAuth 2.0 Credentials (for video upload & publishing)
# Create a Web application OAuth client in Google Cloud Console.
# For Render, set GOOGLE_OAUTH_REDIRECT_URI to:
#   https://<your-service>.onrender.com/publishing/oauth/callback/
# ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/publishing/oauth/callback/

# ─────────────────────────────────────────────────────────────
# TikTok OAuth 2.0 Credentials (Content Posting API)
# Create a TikTok developer app at https://developers.tiktok.com
# Enable products: Login Kit + Content Posting API
# Add redirect URI: http://127.0.0.1:8000/publishing/tiktok/oauth/callback/
# ─────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Gemini video moment analysis (API key remains backend-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANALYSIS_CHUNK_MINUTES=10
MAX_VIDEO_DURATION_SECONDS=7200
MAX_ANALYSIS_VIDEO_SIZE_BYTES=2147483648
MAX_ANALYSIS_CHUNKS=12
MAX_CANDIDATE_MOMENTS=12
VIRAL_MOMENT_MIN_GAP_SECONDS=15
ANALYSIS_BOUNDARY_OVERLAP_SECONDS=10
VIRAL_CONTEXT_BEFORE_SECONDS=3
VIRAL_CONTEXT_AFTER_SECONDS=2

# ─────────────────────────────────────────────────────────────
# Default Settings
# ─────────────────────────────────────────────────────────────
TIME_ZONE=UTC
SYNC_INTERVAL_HOURS=6
